// Copy this file to Secrets.xcconfig in this folder and fill it in.
// Secrets.xcconfig is gitignored. Never paste a key into Xcode build settings
// or Info.plist, because both are committed.
// Run `git config core.hooksPath .githooks` once per clone to turn on the leak check.
ANTHROPIC_API_KEY =
ASSEMBLYAI_API_KEY =
// xcconfig reads // as a comment, so write the URL as https:/$()/<ref>.supabase.co.
SUPABASE_URL =
SUPABASE_PUBLISHABLE_KEY =
